// Prisma schema for database `bilety`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Ticket {
  id         String    @id @default(dbgenerated("newid()")) @map("id")
  status     Int       @map("status")
  created_at DateTime? @db.DateTime @default(dbgenerated("GETDATE()"))
  updated_at DateTime? @db.DateTime

  questions  Question[] @relation("TicketToQuestions")

  @@map("ticket_list")
}

model Question {
  id               String  @id @default(dbgenerated("newid()")) @map("id")
  ticket_id        String  @map("ticket_id")
  question_content String  @db.NVarChar(255)
  answer_list      String  @db.NVarChar(255)
  true_answer      Int
  img_url          String? @db.NVarChar(255)
  question_number  Int

  ticket           Ticket @relation("TicketToQuestions", fields: [ticket_id], references: [id])

  @@map("question_list")
}
